# Diese Datei dokumentiert alle Variablen, die FastAPI-ML verwendet.
#
# Gesucht wird die .env in dieser Reihenfolge:
#   1. AI_ENV_FILE (Umgebungsvariable mit vollem Pfad)
#   2. FastAPI-ML/.env
#   3. .env im Repo-Root (gemeinsam mit scanner/ und flask/)
#   4. .env oberhalb des Arbeitsverzeichnisses
# Liegt die Datei woanders (z.B. myenv/.env), in der systemd-Unit setzen:
#   Environment=AI_ENV_FILE=/root/myenv/.env
# /api/health zeigt unter "env_files", was geladen wurde.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Datenbanknamen (gleiche Logik wie flask/web_server.py)
DB_DATABASE_PROD=ph_fetch_prod
DB_DATABASE_TEST=ph_fetch_test
# Fallback: ist nur DB_DATABASE gesetzt, wird es als Test-DB verwendet.

# FastAPI-ML spezifisch
AI_APP_PORT=8080
AI_DEFAULT_ENV=prod          # prod|test - Umgebung fuer Scheduler-Jobs (lokal: test)
AI_MODELS_DIR=               # leer = FastAPI-ML/models_store
AI_SCHEDULER_ENABLED=1       # 0 = Scheduler aus (Entwicklung, Tests)
AI_TRAIN_DAYS=120            # Trainingsfenster; auf kleinen Servern 45-60 setzen
AI_RETRAIN_ENABLED=1         # 0 = kein naechtliches Training (Modelle extern trainieren)

# Gemini-API fuer intelligenten Chat-Fallback (optional, kostenlos)
GEMINI_API_KEY=              # von aistudio.google.com
AI_CHAT_DAILY_LIMIT=1500    # Max. Requests pro Tag (Free Tier: 1500/Tag)
