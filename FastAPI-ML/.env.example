# Die App liest die .env im Repo-Root (gemeinsam mit scanner/ und flask/).
# Diese Datei dokumentiert alle Variablen, die FastAPI-ML verwendet.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Datenbanknamen (gleiche Logik wie flask/web_server.py)
DB_DATABASE_PROD=ph_fetch_prod
DB_DATABASE_TEST=ph_fetch_test
# Fallback: ist nur DB_DATABASE gesetzt, wird es als Test-DB verwendet.

# FastAPI-ML spezifisch
AI_APP_PORT=8080
AI_DEFAULT_ENV=prod          # prod|test - Umgebung fuer Scheduler-Jobs (lokal: test)
AI_MODELS_DIR=               # leer = FastAPI-ML/models_store
AI_SCHEDULER_ENABLED=1       # 0 = Scheduler aus (Entwicklung, Tests)
