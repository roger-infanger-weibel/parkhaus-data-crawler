[Unit]
Description=Parkhaus FastAPI-ML KI-Prognose (Port 8080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/FastAPI-ML
# --workers 1 ist Pflicht, sonst laeuft der eingebaute Scheduler mehrfach.
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8080 --workers 1
Restart=always
RestartSec=15

# Hartes Speicherlimit: das Training braucht ~735 MB fuer 60 Tage und
# ~1370 MB fuer 120 Tage Fenster. Laeuft etwas aus dem Ruder, killt der
# Kernel nur diesen Dienst - vorher hat ein solcher Fall die ganze Maschine
# ins Swappen gebracht, samt Scanner und Flask.
MemoryMax=1200M
MemoryHigh=1000M

[Install]
WantedBy=multi-user.target
