[Unit]
Description=Parkhaus FastAPI-ML KI-Prognose (Port 80)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/FastAPI-ML
# Liegt die .env nicht in /root oder /root/FastAPI-ML, hier den Pfad setzen:
#Environment=AI_ENV_FILE=/root/myenv/.env
# --workers 1 ist Pflicht, sonst laeuft der eingebaute Scheduler mehrfach.
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 80 --workers 1
Restart=always
RestartSec=15

# Speicherlimit als Notbremse. Das Training braucht ~735 MB fuer 60 Tage und
# ~1370 MB fuer 120 Tage; laeuft etwas aus dem Ruder, stirbt nur dieser Dienst
# statt der ganzen Maschine. Auf einem Server mit wenig RAM entsprechend
# kleiner setzen und das Training dort per AI_RETRAIN_ENABLED=0 abschalten.
MemoryMax=2G
MemoryHigh=1000M

[Install]
WantedBy=multi-user.target
